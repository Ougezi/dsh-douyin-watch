{
  "name": "dsh-douyin-watch",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "One browser substrate, four read surfaces for Douyin (watch, knowledge, comments, creator probes) with quota, decayed memory and a daily report; optional real playback with frame capture. Chrome and Edge.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ougezi/dsh-douyin-watch.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "douyin"
  ]
}
